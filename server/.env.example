# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on. Hosts like Render set this automatically.
PORT=4000

# MongoDB connection string (MongoDB Atlas or a local mongod).
# URL-encode special characters in the password: @ becomes %40, # becomes %23.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/moneytracker?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API.
# Leave unset in local development to allow any origin.
# CLIENT_ORIGIN=https://your-app.vercel.app
